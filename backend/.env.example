APP_ENV=development
PORT=4000
# Copy from Supabase Dashboard > Connect.
# Persistent backend: Direct connection or Session pooler (port 5432).
# Serverless backend: Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_MAX_CONNS=10
DB_AUTO_MIGRATE=false
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
