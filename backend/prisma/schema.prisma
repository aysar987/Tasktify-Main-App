// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  phone         String?        @unique
  passwordHash  String
  fullName      String
  role          Role           @default(CLIENT)
  avatarUrl     String?
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())

  taskerProfile TaskerProfile?
  tasksPosted   Task[]         @relation("ClientTasks")
  bids          Bid[]
  reviewsGiven  Review[]       @relation("Reviewer")
  reviewsGot    Review[]       @relation("Reviewee")
}

model TaskerProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  bio       String?
  skills    String[]
  ktpUrl    String?
  ktpStatus KycStatus @default(PENDING)
  ratingAvg Float     @default(0)
  totalJobs Int       @default(0)
}

model Task {
  id          String     @id @default(cuid())
  clientId    String
  client      User       @relation("ClientTasks", fields: [clientId], references: [id])
  title       String
  description String
  category    String
  budget      Int
  deadline    DateTime?
  status      TaskStatus @default(OPEN)
  createdAt   DateTime   @default(now())

  bids        Bid[]
  transaction Transaction?
  reviews     Review[]
}

model Bid {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id])
  taskerId  String
  tasker    User      @relation(fields: [taskerId], references: [id])
  amount    Int
  message   String?
  status    BidStatus @default(PENDING)
  createdAt DateTime  @default(now())
}

model Transaction {
  id         String   @id @default(cuid())
  taskId     String   @unique
  task       Task     @relation(fields: [taskId], references: [id])
  amount     Int
  commission Int
  midtransId String?
  status     TxStatus @default(PENDING)
  createdAt  DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

enum Role { 
  CLIENT 
  TASKER 
  BOTH 
}

enum KycStatus  { 
  PENDING 
  APPROVED 
  REJECTED 
}

enum TaskStatus { 
  OPEN 
  ASSIGNED 
  IN_PROGRESS 
  COMPLETED 
  CANCELLED 
}

enum BidStatus  { 
  PENDING 
  ACCEPTED 
  REJECTED 
}
enum TxStatus   { 
  PENDING 
  PAID 
  HELD 
  RELEASED 
  REFUNDED 
}